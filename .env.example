# Spotify app client ID (developer.spotify.com/dashboard). Redirect URI: http://127.0.0.1:5173/callback
VITE_SPOTIFY_CLIENT_ID=

# YouTube Data API v3 key (console.cloud.google.com)
YOUTUBE_API_KEY=

# GetSongBPM API key (getsongbpm.com/api) - optional, used for BPM/key ordering
GETSONGBPM_API_KEY=

# Only for the online version: a password so strangers can't use up your YouTube quota.
APP_PASSWORD=
